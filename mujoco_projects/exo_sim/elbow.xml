<mujoco model="elbow_exoskeleton">

    <compiler angle="degree" meshdir="meshes"/>

    <option timestep="0.002" gravity="0 0 -9.81"/>

    <asset>

        <mesh name="upper_arm_mesh"
              file="upper_arm.stl"
              scale="0.001 0.001 0.001"/>

        <mesh name="forearm_mesh"
              file="forearm.stl"
              scale="0.001 0.001 0.001"/>

        <mesh name="upper_arm_orthotic_mesh"
              file="upper_arm_orthotic.stl"
              scale="0.001 0.001 0.001"/>

        <mesh name="forearm_orthotic_mesh"
              file="forearm_orthotic.stl"
              scale="0.001 0.001 0.001"/>

        <mesh name="upper_arm_insert_mesh"
              file="upper_arm_insert.stl"
              scale="0.001 0.001 0.001"/>

        <mesh name="forearm_insert_mesh"
              file="forearm_insert.stl"
              scale="0.001 0.001 0.001"/>

        <mesh name="stop_cover_mesh"
              file="stop_cover.stl"
              scale="0.001 0.001 0.001"/>

    </asset>

    <worldbody>

        <light pos="0 0 2"/>

        <geom name="floor"
              type="plane"
              size="2 2 0.1"
              rgba="0.8 0.8 0.8 1"/>

        <body name="upper_arm" pos="0 0 0.5">

            <geom name="upper_arm_link_visual"
                  type="mesh"
                  mesh="upper_arm_mesh"
                  rgba="0.35 0.35 0.35 1"
                  contype="0"
                  conaffinity="0"/>

            <geom name="upper_arm_orthotic_visual"
                  type="mesh"
                  mesh="upper_arm_orthotic_mesh"
                  rgba="0.55 0.55 0.55 1"
                  contype="0"
                  conaffinity="0"/>

            <geom name="upper_arm_insert_visual"
                  type="mesh"
                  mesh="upper_arm_insert_mesh"
                  rgba="0.25 0.25 0.25 1"
                  contype="0"
                  conaffinity="0"/>

            <body name="forearm" pos="0 0 0">

                <joint name="elbow"
                       type="hinge"
                       axis="0 1 0"
                       range="0 115"
                       damping="1"/>

                <geom name="forearm_link_visual"
                      type="mesh"
                      mesh="forearm_mesh"
                      rgba="0.65 0.65 0.65 1"
                      contype="0"
                      conaffinity="0"/>

                <geom name="forearm_orthotic_visual"
                      type="mesh"
                      mesh="forearm_orthotic_mesh"
                      rgba="0.75 0.75 0.75 1"
                      contype="0"
                      conaffinity="0"/>

                <geom name="forearm_insert_visual"
                      type="mesh"
                      mesh="forearm_insert_mesh"
                      rgba="0.3 0.3 0.3 1"
                      contype="0"
                      conaffinity="0"/>

                <geom name="stop_cover_visual"
                      type="mesh"
                      mesh="stop_cover_mesh"
                      rgba="0.4 0.4 0.4 1"
                      contype="0"
                      conaffinity="0"/>

            </body>

        </body>

    </worldbody>

    <actuator>

        <position name="elbow_motor"
                  joint="elbow"
                  kp="20"
                  ctrlrange="0 115"/>

    </actuator>

</mujoco>
